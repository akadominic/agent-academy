# Agent Academy works fully WITHOUT any of these. They only enable optional live AI.
# Copy to .env.local (never commit .env.local) and fill in.

# Master switch for live AI features (sandbox live mode + live tutor)
LIVE_AI_ENABLED=false

# Anthropic (https://docs.claude.com) — pick a current model name from the docs
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# OpenAI (https://platform.openai.com/docs) — pick a current model name from the docs
OPENAI_API_KEY=
OPENAI_MODEL=

# Usage limits (protect your bill). Defaults shown.
LIVE_MAX_OUTPUT_TOKENS=600
LIVE_REQUESTS_PER_IP_PER_HOUR=30
LIVE_DAILY_REQUEST_CAP=300

# Optional: require this code (sent by the browser) before live AI is used on a public deployment
LIVE_ACCESS_CODE=
